<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-targeted on purpose. The tool only does real work on Windows, but
         the parser/model/reporting tests run on the Linux dev box, so the
         plain net10.0 flavour has to stay buildable and runnable there.
         CsWin32 and everything under Core/Native are Windows-only. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PinnacleCyPat</RootNamespace>
    <AssemblyName>PinnacleCyPat</AssemblyName>

    <!-- Author Information -->
    <Authors>Maxwell McCormick</Authors>
    <Company>Maxwell McCormick</Company>
    <Product>PinnacleCyPat</Product>
    <Description>Automated security hardening tool for CyberPatriot competitions</Description>
    <Copyright>Copyright 2026 Maxwell McCormick. Licensed under Apache-2.0.</Copyright>
    <!-- Apache-2.0; see LICENSE at the repository root. IsPackable=false because
         this is an archived application, not a library anyone should package. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <!-- Bump with every behavioural change. The run log stamps this value in its
         header and file name so a log ties back to the build that produced it. -->
    <Version>1.8.0</Version>

    <!-- Self-contained single-file publish profile.
         Gated on _IsPublishing so `dotnet build`/`dotnet test` stay
         RID-agnostic: the test project references this one, and a global
         RuntimeIdentifier would make the test assemblies win-x64 and therefore
         unrunnable on the Linux/CI hosts the suite runs on.
         Because the project multi-targets, publishing needs the framework named
         explicitly:
           dotnet publish src/PinnacleCyPat.csproj -c Release \
             -f net10.0-windows -o publish-win-x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>

    <!-- Precompile IL to native code. The tool starts, does its work and exits,
         so first-run JIT is a real share of its total runtime rather than a cost
         amortised over a long-lived process. Measured at +3.8 MB (38.2 -> 42.0). -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Ship only English resources from dependencies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Trimming is deliberately NOT enabled, despite being the single largest
         size win available here: it takes the published exe from 38 MB to 12 MB
         and currently produces no IL2xxx warnings.

         The reason is that Spectre.Console 0.47 and System.CommandLine both
         resolve types by reflection, and neither is fully trim-annotated - so an
         absence of warnings is weak evidence rather than proof. A trimmed build
         that loses Spectre's markup rendering fails at run time, during a scored
         round, with no warning at build time.

         Enable it once it has been exercised end to end on a real Windows host:
           dotnet publish src/PinnacleCyPat.csproj -c Release \
             -f net10.0-windows -p:PublishTrimmed=true -o publish-win-x64 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Reproducible output: the same source produces the same bytes, so a
         binary can be tied back to the commit that produced it. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Win32 P/Invoke, generated at compile time from NativeMethods.txt. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'Windows'">
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The native implementations only compile for the Windows TFM; the plain
       net10.0 flavour falls back to the shell-out paths. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'Windows'">
    <Compile Remove="Core/Native/**/*.cs" />
    <None Include="NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
    <!-- Code Formatting -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.2.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
