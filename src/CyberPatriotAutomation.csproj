<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CyberPatriotAutomation</RootNamespace>
    <AssemblyName>CyberPatriotAutomation</AssemblyName>

    <!-- Author Information -->
    <Authors>Maxwell McCormick</Authors>
    <Company>Maxwell McCormick</Company>
    <Product>CyberPatriot Automation Tool</Product>
    <Description>Automated security hardening tool for CyberPatriot competitions</Description>
    <Copyright>Copyright (c) 2026 Maxwell McCormick. All Rights Reserved.</Copyright>
    <!-- Bump with every behavioural change. The run log stamps this value in its
         header and file name so a log ties back to the build that produced it. -->
    <Version>1.4.0</Version>

    <!-- Self-contained single-file publish profile.
         Gated on _IsPublishing so `dotnet build`/`dotnet test` stay
         RID-agnostic: the test project references this one, and a global
         RuntimeIdentifier would make the test assemblies win-x64 and therefore
         unrunnable on the Linux/CI hosts the suite runs on. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
    <!-- Code Formatting -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.2.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
