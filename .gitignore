# .gitignore for PinnacleCyPat. Cargo build output is ignored in rust/.gitignore.

# Publish output from scripts/publish.sh (publish-win-x64/, publish-linux-x64/).
# Build output, never committed.
publish/
publish-*/

# Editors
.idea/
.vscode/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Others
*.bak
*.tmp
*.old
*.orig

# Claude Code per-machine permission cache; not project content.
.claude/settings.local.json

# Scratch files and extra build dirs (agents and humans): never committed.
.scratch/
# Agent worktrees: temporary checkouts, merged by hand, never committed.
.claude/worktrees/
